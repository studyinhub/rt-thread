var url = "http://47.94.84.166:9000/images/webnet.zip"
var path = "/" + ..inet.url.getFileName(url); 
 
// https://bbs.aardio.com/forum.php?mod=viewthread&tid=6796&highlight=zip

function unzip(){
	var ok,err = zlib.unzip.extract( path,"/res",
        function(fileName,extractPath,fileInfo,size,unitSize,unitName){
                if( size !== null )
                        ..io.print( "正在解压文件",fileName,size++ unitName );
                else {
                        ..io.print( "正在解压目录",fileName );
                }
                
                return true;
        }
)
}

function download(){
	
	
	var whttp = inet.http();
	assert( whttp.beginRequest( url ) ) 
	
	var ok,code,contentLength = whttp.send(); 
	if(!ok) {
		io.print("error:",code)
		return;
	};
	
	//取得文件长度 
	if(contentLength){
		io.print(fsys.formatSize(contentLength));
	}
	else {
		contentLength = 1024 * 500;
	}
		

	var file = io.open( path,"w+b")
	var buffer = ..raw.buffer( 1024 );
	
	for( 长度 in whttp.eachReadBuffer(buffer)){
		file.writeBuffer(buffer,长度);
	}  
	
	file.close();
	
	//process.explore_select(path)
}

function upload(){
	var relativePath= fsys.path.canonicalize("/res/webnet")
	io.print("relativePath:",relativePath)
	
	fsys.enum( "/res/webnet", "*.*",
	function(dirname,filename,fullpath,findData){ 
		if(filename){ 
	        //io.print("发现文件："+filename,"完整路径："+fullpath)/*可使用 return false退出枚举文件过程*/
	        //io.print("相对路径：",io.localpath("res/pack_src"))
	        //io.print("短路径：",fsys.path.short(fullpath))
	        // 等待外部执行完毕，不会结束外部进程
	    	var cmd = `curl -T %s tftp://192.168.1.100/%s`
	    	
	    	sourcePath = fullpath
	    	targetPath = fsys.path.relative(fullpath,relativePath,false)
	    	targetPath = string.replace(targetPath,"@\","/")
	    	cmd= string.format(cmd,sourcePath,targetPath)
	    	io.print("cmd:",cmd)
	   
			var prcs = process.popen(cmd);
			io.print("返回结果",prcs.logResponse());

	    		
		}
		else{
			//io.print( "发现目录：" + dirname )
		}
	},
	function(dirpath,dirname){
		
		return true;
	}
	)
}

function clear()
{
	fsys.delete(path)
	fsys.delete("/res/webnet")	
}


