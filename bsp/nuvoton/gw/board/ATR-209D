static void reset_tty_atexit(void)
{
	if (saved_portfd != -1)
	{
		tcsetattr(saved_portfd, TCSANOW, &oldtios);
	}
}

/*cheanup signal handler */
static void reset_tty_handler(int signal)
{
	if (saved_portfd != -1)
	{
		tcsetattr(saved_portfd, TCSANOW, &oldtios);
	}
	_exit(EXIT_FAILURE);
}

static int open_port(const char *portname, uint32_t baudrate, uint32_t databits, uint32_t parity, uint32_t stopbits, uint8_t vmin, uint8_t vtime)
{
	uint32_t speed;
	struct sigaction sa;
	int portfd;

	printf("opening serial port:%s\n", portname);

	/*open serial port */
	if ((portfd = open(portname, O_RDWR | O_NOCTTY | O_NDELAY)) < 0)
	{
		printf("open serial port %s fail \n ", portname);
		return portfd;
	}

	/*get serial port parnms,save away */
	tcgetattr(portfd, &newtios);
	memcpy(&oldtios, &newtios, sizeof newtios);

	switch (baudrate)
	{
	case 300:
		speed = B300;
		break;
	case 600:
		speed = B600;
		break;
	case 1200:
		speed = B1200;
		break;
	case 2400:
		speed = B2400;
		break;
	case 4800:
		speed = B4800;
		break;
	case 9600:
		speed = B9600;
		break;
	case 19200:
		speed = B19200;
		break;
	case 38400:
		speed = B38400;
		break;
	case 57600:
		speed = B57600;
		break;
	case 115200:
		speed = B115200;
		break;
	default:
		printf("Unsupported baudrate \n");
		return -2;
	}
	/* 115200 bps */
	cfsetospeed(&newtios, speed);
	cfsetispeed(&newtios, speed);

	switch (databits)
	{
	case 8:
		newtios.c_cflag &= ~CSIZE;
		newtios.c_cflag |= CS8;
		break;
	case 7:
		newtios.c_cflag &= ~CSIZE;
		newtios.c_cflag |= CS7;
		break;
	case 6:
		newtios.c_cflag &= ~CSIZE;
		newtios.c_cflag |= CS6;
		break;
	case 5:
		newtios.c_cflag &= ~CSIZE;
		newtios.c_cflag |= CS5;
		break;
	default:
		printf("Unsupported data size\n");
		return -3;
	}

	switch (parity)
	{
	case 0: // non-parity
		newtios.c_cflag &= ~PARENB;
		newtios.c_iflag &= ~INPCK;
		break;

	case 1: // odd-parity
		newtios.c_cflag |= (PARODD | PARENB);
		newtios.c_iflag |= (INPCK | ISTRIP);
		break;

	case 2: // even-parity
		newtios.c_cflag |= PARENB;
		newtios.c_cflag &= ~PARODD;
		newtios.c_iflag |= (INPCK | ISTRIP);
		break;
	default:
		printf("Unsupported parity\n");
		return -4;
	}

	// stop-bits
	switch (stopbits)
	{
	case 1:
		newtios.c_cflag &= ~CSTOPB;
		break;
	case 2:
		newtios.c_cflag |= CSTOPB;
		break;
	default:
		printf("Unsupported stop bits\n");
		return -5;
	}

	/* configure new values */
	//cfmakeraw(&newtios); /*see man page */

	//newtios.c_iflag |=INPCK; /*ignore parity on input */
	newtios.c_iflag &= ~(IXON | IXOFF | IXANY);
	newtios.c_lflag &= ~(ICANON | ECHO | ECHOE | ISIG);
	newtios.c_cflag |= CLOCAL | CREAD;
	newtios.c_oflag &= ~OPOST;

	newtios.c_cc[VMIN] = vmin;	 /* block until 1 char received */
	newtios.c_cc[VTIME] = vtime; /*no inter-character timer */

	/* register cleanup stuff */
	saved_portfd = portfd;
	atexit(reset_tty_atexit);
	memset(&sa, 0, sizeof sa);
	sa.sa_handler = reset_tty_handler;
	sigaction(SIGHUP, &sa, NULL);
	sigaction(SIGINT, &sa, NULL);
	sigaction(SIGPIPE, &sa, NULL);
	sigaction(SIGTERM, &sa, NULL);

	/*apply modified termios */
	tcflush(portfd, TCIOFLUSH);
	tcsetattr(portfd, TCSANOW, &newtios);
	return portfd;
}

static int RTU_open_port(const char *portname)
{
	int portfd;
	int RTUdata = 0;
	int RTUlenth = 0;
	FILE *fp = NULL;
	cJSON *json;
	char *buf;

	_UART_PARS_s UART_Conf;

	if ((fp = fopen(JsonFileName, "rb")) == NULL)
	{ //只读方式打开文件
		printf("openfile error.");
		return -1;
	}
	fseek(fp, 0, SEEK_END); // 确定文件大小, 并将读取指针移回文件开始
	long pos = ftell(fp);
	fseek(fp, 0, SEEK_SET);
	if (pos < 0)
	{
		printf("invalid file fail");
		return -1;
	}
	buf = malloc(pos + 1); // 根据文件大小申请内存空间,多申请1个字节用于存放'\0'
	if (buf == NULL)
	{
		printf("no enough memory");
		return -1;
	}
	int nread = fread(buf, pos, 1, fp); // 读取文件内容至buff
	if (!nread)
	{
		printf("failed to read file.");
		fclose(fp); // 关闭文件
		return -1;
	}
	fclose(fp);		 // 关闭文件
	buf[pos] = '\0'; // 关闭字符串结尾

	//printf("JSON RUN IN:%s\n",buf);
	json = cJSON_Parse(buf); //获取整个大的句柄
	if (!json)
	{
		printf("JSON format wrong \n");
		return -1;
	}
	//buf=cJSON_Print(json);  //这个是可以输出的。为获取的整个json的值
	cJSON *arrayItem = cJSON_GetObjectItem(json, "RS485"); //获取这个对象成员
	//因为这个对象是个数组获取，且只有一个元素所以写下标为0获取
	cJSON *item = cJSON_GetObjectItem(arrayItem, "Baud");
	UART_Conf.baudrate = atoi(item->valuestring);
	printf("Baud:%d \n", UART_Conf.baudrate);

	item = cJSON_GetObjectItem(arrayItem, "Lenth");
	UART_Conf.datalen = atoi(item->valuestring);
	printf("Lenth:%d\n", UART_Conf.datalen);

	item = cJSON_GetObjectItem(arrayItem, "Parity");
	if (*(item->valuestring) == 'N')
		UART_Conf.odd = 0; //0: non-parity  //1: odd-parity  //2: even-parity
	if (*(item->valuestring) == 'O')
		UART_Conf.odd = 1; //0: non-parity  //1: odd-parity  //2: even-parity
	if (*(item->valuestring) == 'E')
		UART_Conf.odd = 2; //0: non-parity  //1: odd-parity  //2: even-parity
	printf("Parity:%d \n", UART_Conf.odd);

	item = cJSON_GetObjectItem(arrayItem, "Stop");
	UART_Conf.stopbit = atoi(item->valuestring);
	printf("Stop:%d\n", UART_Conf.stopbit);

	item = cJSON_GetObjectItem(arrayItem, "RTU01addr");
	RTUdata = atoi(item->valuestring);
	//printf("PLCaddr:%d\n",PLCdata);
	RTU01_REGaddr[0] = (RTUdata >> 8) & 0xFF;
	RTU01_REGaddr[1] = RTUdata & 0xFF;
	printf("RTU01addr[0]:%d\n", RTU01_REGaddr[0]);
	printf("RTU01addr[1]:%d\n", RTU01_REGaddr[1]);

	item = cJSON_GetObjectItem(arrayItem, "RTU03addr");
	RTUdata = atoi(item->valuestring);
	//printf("PLCaddr:%d\n",PLCdata);
	RTU03_REGaddr[0] = (RTUdata >> 8) & 0xFF;
	RTU03_REGaddr[1] = RTUdata & 0xFF;
	printf("RTU03addr[0]:%d\n", RTU03_REGaddr[0]);
	printf("RTU03addr[1]:%d\n", RTU03_REGaddr[1]);

	item = cJSON_GetObjectItem(arrayItem, "RTU01lenth");
	RTUlenth = atoi(item->valuestring);
	//printf("PLCaddr:%d\n",PLCdata);
	RTU01_REGlenth[0] = (RTUlenth >> 8) & 0xFF;
	RTU01_REGlenth[1] = RTUlenth & 0xFF;
	printf("RTU01lenth[0]:%d\n", RTU01_REGlenth[0]);
	printf("RTU01lenth[1]:%d\n", RTU01_REGlenth[1]);

	item = cJSON_GetObjectItem(arrayItem, "RTU03lenth");
	RTUlenth = atoi(item->valuestring);
	//printf("PLCaddr:%d\n",PLCdata);
	RTU03_REGlenth[0] = (RTUlenth >> 8) & 0xFF;
	RTU03_REGlenth[1] = RTUlenth & 0xFF;
	printf("RTU03lenth[0]:%d\n", RTU03_REGlenth[0]);
	printf("RTU03lenth[1]:%d\n", RTU03_REGlenth[1]);

	cJSON_Delete(json);

	portfd = open_port(portname, UART_Conf.baudrate, UART_Conf.datalen, UART_Conf.odd, UART_Conf.stopbit, 128, 10);
	return portfd;
}

