int ModbusCRC(uint8_t *str, uint32_t len)
{
	uint8_t temp;
	uint8_t g_lowCrcbyte = 0xFF;
	uint8_t g_highCrcbyte = 0xFF;

	while (len--)
	{
		temp = *str++ ^ g_lowCrcbyte;
		g_lowCrcbyte = CRCHighTable[temp] ^ g_highCrcbyte;
		g_highCrcbyte = CRCLowTable[temp];
	}
	return (g_highCrcbyte * 0x100 + g_lowCrcbyte);
}

