				else
					TempL = ASCII_RxBuffer[5] - 0x30;
				ASCII_TxBuffer[8] = TempH * 16 + TempL;

				CRCdata = ModbusCRC(ASCII_TxBuffer, 9);
				ASCII_TxBuffer[9] = CRCdata & 0xFF;
				ASCII_TxBuffer[10] = (CRCdata >> 8) & 0xFF;
				write(fd[1], ASCII_TxBuffer, 11);
				break;
			default:
				write(fd[0], "Read Data Error \n\r", 18);
				break;
			}
		}
		else if (rev > 0)
			write(fd[0], "Send Data Error \n\r", 18);
		usleep(1000);
	}
}

void *process2(void *arg)
{
	int CRCdata = 0;
	int rev1 = 0;
	int i = 0;
	int nub = 1;
	char RxBuffer[256];

	char RTU03_TxBuffer[8] = {0x01, 0x03, 0, 0, 0, 0x08, 0x44, 0x06};
	char RTU01_TxBuffer[8] = {0x01, 0x01, 0, 0, 0, 0x28, 0x44, 0x06};

	RTU01_TxBuffer[0] = MODBUSID & 0xFF;
	RTU01_TxBuffer[2] = RTU01_REGaddr[0];
	RTU01_TxBuffer[3] = RTU01_REGaddr[1];
	RTU01_TxBuffer[4] = RTU01_REGlenth[0];
	RTU01_TxBuffer[5] = RTU01_REGlenth[1];
	CRCdata = ModbusCRC(RTU01_TxBuffer, 6);
	RTU01_TxBuffer[6] = CRCdata & 0xFF;
	RTU01_TxBuffer[7] = (CRCdata >> 8) & 0xFF;

	RTU03_TxBuffer[0] = MODBUSID & 0xFF;
	RTU03_TxBuffer[2] = RTU03_REGaddr[0];
	RTU03_TxBuffer[3] = RTU03_REGaddr[1];
	RTU03_TxBuffer[4] = RTU03_REGlenth[0];
	RTU03_TxBuffer[5] = RTU03_REGlenth[1];
	CRCdata = ModbusCRC(RTU03_TxBuffer, 6);
	RTU03_TxBuffer[6] = CRCdata & 0xFF;
	RTU03_TxBuffer[7] = (CRCdata >> 8) & 0xFF;

	//printf("RTU_TxBuffer UP %s byts \n ",RTU_TxBuffer);

	while (1)
	{
		if (nub == 3)
		{
			write(fd[1], RTU03_TxBuffer, 8);
			//printf("\n uart7 send RTU03 %s byts\n ", RTU03_TxBuffer);
			nub = 1;
		}
		else if (nub == 1)
		{
			write(fd[1], RTU01_TxBuffer, 8);
			//printf("\n uart7 send RTU01 %s byts\n ", RTU01_TxBuffer);
			nub = 3;
		}
		usleep(1000);
		rev1 = read(fd[1], RxBuffer, 256);
		if (rev1 > 0)
		{
			//printf("\n uart9 rev %d %x byts\n ", rev1,RxBuffer);

			if ((RxBuffer[0] == (MODBUSID & 0xFF)) && (RxBuffer[1] == 0x03))
			{
				for (i = 0; i < RxBuffer[2]; i++)
				{
					Regdate03[i] = RxBuffer[i + 3];
				}
			}
			if ((RxBuffer[0] == (MODBUSID & 0xFF)) && (RxBuffer[1] == 0x01))
			{
				for (i = 0; i < RxBuffer[2]; i++)
				{
					Regdate01[i] = RxBuffer[i + 3];
				}
			}
			memset(RxBuffer, 0, 256);
			sleep(1);
		}
		sleep(3);
		//printf("RTU_TxBuffer %X byts\n ",RTU_TxBuffer);
	}
}

