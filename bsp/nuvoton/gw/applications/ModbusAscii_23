/////////////////////////CRC函数
int CRC(uint8_t buf[], int len)//CRC校验函数，返回16位CRC校验值
{
	uint8_t byCRCHi = 0xff;
	uint8_t byCRCLo = 0xff;
	uint8_t byIdx;
	uint16_t crc;

	while (len--)
	{
		byIdx = byCRCHi ^ *buf++;
		byCRCHi = byCRCLo ^ gabybootCRCHi[byIdx];
		byCRCLo = gabybootCRCLo[byIdx];
	}

	crc = byCRCHi;
	crc <<= 8;
	crc += byCRCLo;
	return crc;
}

char ATOHChar(char var1, char var2)//ASCII 字符串 转8位16进制数 '12'转为0x12
{
	char temp=0;
	if (var1>=0x30 && var1 <=0x39)
	   temp=var1-'0';
	else if (var1>=0x30 && var1 <=0x39)
	   temp=var1-'A'+10;
    temp<<4;
	if (var1>=0x30 && var1 <=0x39)
	   temp=temp+var2-'0';
	else if(var2>='A' && var2 <='F')
	   temp=temp+var2-'A'+10;
    return temp;
}
int ATOHInt(char var1, char var2,char var3,char v4)//ASCII 字符串 转16位16进制数 '12AB'转为0x12AB
{
	int temp=0;
	if (var1>=0x30 && var1 <=0x39)
	   temp=var1-'0';
	else if (var1>=0x30 && var1 <=0x39)
	   temp=var1-'A'+10;
    temp<<4;
	if (var2>=0x30 && var2 <=0x39)
	   temp=temp+var2-'0';
	else if(var2>='A' && var2 <='F')
	   temp=temp+var2-'A'+10;
	temp<<4;
    if (var3>=0x30 && var3 <=0x39)
	   temp=temp+var3-'0';
	else if(var3>='A' && var3 <='F')
	   temp=temp+var3-'A'+10;
	temp<<4;
    if (var4>=0x30 && var4 <=0x39)
	   temp=temp+var4-'0';
	else if(var4>='A' && var4 <='F')
	   temp=temp+var4-'A'+10;
   
    return temp;	  
}
char HToAChar(char var1)  //4位16进制数，转ASCII字符  0,1,2,3 转 ‘0’，‘1’，‘2’，‘3’
{
char temp=0;
if (var1>=0 && var1 <=9)
	temp=var1+'0';
else if(var1 >=0x0A && var1<=0x0F)
	temp=var1-10+'A';
return temp;	
}

