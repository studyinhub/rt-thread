void RS384A_SerialUARTIntHandler(void)//上位机的端口RS485A的接收中断
{
int ReadDatStAdd;//上位机要的读的数据起始地址
int ReadDatLenth;//上位机要读的数据的长度
int WriteDatStAdd;//上位机要写的数据的起始地址
int WriteDatLenth;//上位机要写的数据的长度
int WriteByteNum;//上位机要写的数据的字节长度=数据长度*2
int crc;
char sum;
int i;
int k;

clock_t start = 0, end = 0;	
start = clock();
while (1)//接收上位机来的数据
{
	if(CanRecvA<=1)
		CanRecvA=1;
	len = read(mb_RS485A, RXBuff_Rs458A + 512 - CanRecvA, CanRecvA); //接收数据
	if (len > 0)
	{
		start = clock();		 //收到数据，重新开始计时，返回值单位：微秒
		CanRecvA = CanRecvA - len; //还可以接收的总字节数
	}
	else
	{
		usleep(1000);  //延时1毫秒
		end = clock(); //返回值单位：微秒
		if ((end - start) > 10000) //间隔超时 10毫秒
		break;
	}
}
RecLen = 512 - CanRecvA;//接收到的总字节数

//按modbus Ascii解析
	for(i=0;i<RecLen;i++)//从头开始查找，找到完成的一包数据
	{ 
		if (!RXBuff_Rs458A[i]==':')//‘:’符合，
			continue;
		if (!ATOHChar(RXBuff_Rs458A[i+1],RXBuff_Rs458A[i+2])==0x17)//功能代码符合0x17
			continue;
		ReadDatStAdd=ATOHInt(RXBuff_Rs458A[i+3],RXBuff_Rs458A[i+4],RXBuff_Rs458A[i+5],RXBuff_Rs458A[i+6]);//功能代码23（0x17)要读取的数据起始地址，占4个字节[3]~[6]
		ReadDatLenth=ATOHInt(RXBuff_Rs458A[i+7],RXBuff_Rs458A[i+8],RXBuff_Rs458A[i+9],RXBuff_Rs458A[i+10]);//功能代码23（0x17)要读取的数据长度，占4个字节[7]~[10]
		if (!(ReadDatStAdd>=RAddLimitMin && ReadDatStAdd<=RAddLimitMax && ReadDatStAdd+ReadDatLenth>=RAddLimitMin+1  &&  ReadDatStAdd+ReadDatLenth<=RAddLimitMax+1))//读的地址和长度符合
			//起始地址不能超范围，起始地址+数据长度不能超范围
			continue;
		WriteDatStAdd=ATOHInt(RXBuff_Rs458A[i+11],RXBuff_Rs458A[i+12],RXBuff_Rs458A[i+13],RXBuff_Rs458A[i+14]);//功能代码23（0x17)要写取的数据起始地址，占4个字节[11]~[14]
		WriteDatLenth=ATOHInt(RXBuff_Rs458A[i+15],RXBuff_Rs458A[i+16],RXBuff_Rs458A[i+17],RXBuff_Rs458A[i+18]);//功能代码23（0x17)要写取的数据长度，占4个字节[15]~[18]
		WriteByteNum=ATOHChar(RXBuff_Rs458A[i+19], RXBuff_Rs458A[i+20])//功能代码23（0x17)要写取的数据字节个数，占2个字节[19]~[20]
		if (!(WriteByteNum==WriteDatLenth*2&&(WriteDatLenth==0||(WriteDatLenth>0 && WriteDatStAdd>=WAddLimitMin && WriteDatStAdd<=WAddLimitMax && WriteDatStAdd+WriteDatLenth>=WAddLimitMin+1  &&  WriteDatStAdd+WriteDatLenth<=WAddLimitMax+1))))//写的地址和长度符合
			//写的数据的起始地址不能超范围，写的数据起始地址+数据长度不能超范围
			continue; 
		if (RecLen-i<21+WriteByteNum*4+4)//如果轮循剩下的字节不足21+WriteByteNum则停止轮循，退出，接收数据不完整
			return;   
		for(k=1;k<21+WriteByteNum*4;k++) //求校验和
			sum=RXBuff_Rs458A[k];
	    if (!(sum==ATOHChar(RXBuff_Rs458A[21+WriteByteNum*4]),RXBuff_Rs458A[22+WriteByteNum*4]))//LRC校验和符合
			continue; 
		if(!(RXBuff_Rs458A[23+WriteByteNum*4]==0x0D && RXBuff_Rs458A[24+WriteByteNum*4]==0x0A))//结束符0x0D,和0x0A符合
			continue; 
	    //如果都符合,则准备给上位机回复上位机想要的数据
	    //modbus Ascii
		TXBuff_Rs458A[0]=':';//起始位“:”
		TXBuff_Rs458A[1]=HToAChar(MasterID/0x10);//设备地址高4位
		TXBuff_Rs458A[2]=HToAChar(MasterID%0x10);//设备地址低4位		
		TXBuff_Rs458A[3]='1';//功能代码地址高4位
		TXBuff_Rs458A[4]='7';//功能代码地址低4位
		TXBuff_Rs458A[5]=HToAChar(char(ReadDatLenth*2)/0x10);//数据字节长度高4位
		TXBuff_Rs458A[6]=HToAChar(char(ReadDatLenth*2)%0x10);//数据字节长度低4位
		sum=TXBuff_Rs458A[1]+TXBuff_Rs458A[2]+TXBuff_Rs458A[3]+TXBuff_Rs458A[4]+TXBuff_Rs458A[5]+TXBuff_Rs458A[6]；//前面6个数的LRC校验和
		for(k=0;k<ReadDatLenth;k++)//每个数据占四个字节
		{
			TXBuff_Rs458A[7+k*4]=HToAChar(DataReg[ReadDatStAdd]/0x1000%0x10);
			sum=sum+TXBuff_Rs458A[7+k*4];
			TXBuff_Rs458A[8+k*4]=HToAChar(DataReg[ReadDatStAdd]/0x100%0x10);
			sum=sum+TXBuff_Rs458A[8+k*4];
			TXBuff_Rs458A[9+k*4]=HToAChar(DataReg[ReadDatStAdd]/0x10%0x10);
			sum=sum+TXBuff_Rs458A[9+k*4];
			TXBuff_Rs458A[10+k*4]=HToAChar(DataReg[ReadDatStAdd]%0x10);
			sum=sum+TXBuff_Rs458A[10+k*4];		
		}
		TXBuff_Rs458A[7+k*4]=HToAChar(sum/0x10);//LRC校验和高4位,注意此时的k等于ReadDatLenth
		TXBuff_Rs458A[8+k*4]=HToAChar(sum%0x10);//LRC校验和低4位		
		TXBuff_Rs458A[9+k*4]=0x0d;//回车
		TXBuff_Rs458A[10+k*4]=0x0a;//换行
		sendLenth=11+k*4;//发送字节长度
		SentA(TXBuff_Rs458A,sendLenth);
		memset(TXBuff_Rs458A,'\0',sizeof(TXBuff_Rs458A));//清空RS485A接收缓存
		if(WriteByteNum==WriteDatLenth*2 && WriteDatLenth>0) //如果上位机有写数据，则将接收到的要写的数据先放到WDataReg[]数组中，然后给控制器发送16指令，将这些数据写给控制器,如果没有则不执行
		{//RTU
			TXBuff_Rs458B[0]=SlaverID;//控制器通讯地址
			TXBuff_Rs458B[1]=0x10;//这里需要注意，控制器支不支持0x10指令，如果不支持，则需要通过0x06将多个数据多次发送
			TXBuff_Rs458B[2]=WriteDatStAdd/0x100;//给控制器写的起始地址高8位
			TXBuff_Rs458B[3]=WriteDatStAdd%0x100;//给控制器写的起始地址低8位
			TXBuff_Rs458B[4]=WriteDatLenth%0x100;//给控制器写的数据个数高8位
			TXBuff_Rs458B[5]=WriteDatLenth%0x100;//给控制器写的数据个数低8位			
			TXBuff_Rs458B[6]=WriteByteNum;//给控制器写的数据的总字节数
			for(k=0;k<WriteDatLenth;k++)//每个写的数据占两个字节
			{
				WDataReg[WriteDatStAdd+k]=ATOHInt(RXBuff_Rs458A[i+21+k*4],RXBuff_Rs458A[i+22+k*4],RXBuff_Rs458A[i+23+k*4],RXBuff_Rs458A[i+24+k*4]);
				TXBuff_Rs458B[7+k*2]=WDataReg[WriteDatStAdd+k]/0x100;
				TXBuff_Rs458B[8+k*2]=WDataReg[WriteDatStAdd+k]%0x100;
			}
			crc=CRC(TXBuff_Rs458B, 7+k*2);//CRC校验，7+k*2是校验的长度			
			TXBuff_Rs458B[7+k*2]=crc/0x100;//校验值高8位
			TXBuff_Rs458B[8+k*2]=crc%0x100;//校验值低8位
			sendLenth=9+k*2	//发送的总字节数			
			
			SentB(TXBuff_Rs458B,sendLenth);
			memset(TXBuff_Rs458B,'\0',sizeof(TXBuff_Rs458B));//清空RS485B发送缓存
		}
	}	
}

void RS485B_TXTimer()//定时器中断，每隔时钟周期发一次modbus RTU 功能代码3 取取下位机的数据
{
	int crc;
	memset(TXBuff_Rs458B,'\0',sizeof(TXBuff_Rs458B));
	TXBuff_Rs458B[0]=SlaverID;
	TXBuff_Rs458B[1]=0x03;//这里需要注意，控制器支不支持0x10指令，如果不支持，则需要通过0x06将多个数据多次发送
	TXBuff_Rs458B[2]=RTUReadStartAdd/0x100;
	TXBuff_Rs458B[3]=RTUReadStartAdd%0x100;
	TXBuff_Rs458B[4]=RTUReadLenth/0x100;
	TXBuff_Rs458B[5]=RTUReadLenth%0x100;	
	crc=CRC(&TXBuff_Rs458B[0],6);
	TXBuff_Rs458B[6]=crc/0x100;
	TXBuff_Rs458B[7]=crc%0x100;
	SentB(TXBuff_Rs458B,8);	
	memset(TXBuff_Rs458B,'\0',sizeof(TXBuff_Rs458B));////清空RS485B发送缓存
}

void RS384B_SerialUARTIntHandler(void)//下位机的端口RS485B的接收中断，接收下位机（控制器）的modbus RTU 回复数据
{
	clock_t start = 0, end = 0;	
	int RecLen;
	start = clock();
	while (1)//接收上位机来的数据
	{
		if(CanRecvB<=1)
			CanRecvB=1;
		len = read(mb_RS485A, RXBuff_Rs458A + 512 - CanRecvB, CanRecvB); //接收数据
		if (len > 0)
		{
			start = clock();		 //收到数据，重新开始计时，返回值单位：微秒
			CanRecvB = CanRecvB - len; //还可以接收的总字节数
		}
		else
		{
			usleep(1000);  //延时1毫秒
			end = clock(); //返回值单位：微秒
			if ((end - start) > 10000) //间隔超时 10毫秒
			break;
		}
	}
	RecLen = 512 - CanRecvB;//接收到的总字节数	
	for(i=0;i<RecLenB;i++)//从头开始查找，找到完成的一包数据
	{
        if(!(RXBuff_Rs458B[i]==SlaverID))//下位机发送地址符合
			continue;
		if (!(RXBuff_Rs458B[i+1]==0x03))//下位机发送的功能代码符合
			continue;
		if(!(RXBuff_Rs458B[i+2]==RTUReadLenth*2))//下位机发送数据字节长度符合
			continue;
		if(RecLenB-i<5+RTUReadLenth*2)//如果剩余未查询的寄存器数量符合一包完整数据包长度
			return;
		if(!(CRC(&RXBuff_Rs458B[i],i+2+RTUReadLenth)==RXBuff_Rs458B[i+2+RTUReadLenth]*0x100+RXBuff_Rs458B[i+3+RTUReadLenth]))//校验符合
			continue;
		for(i=0;i<RTUReadLenth;i++)//将下位机返回的数据放到接收数据RDataReg寄存器内
		{
			RDataReg[i]=RXBuff_Rs458B[3+i*2]*0x100+RXBuff_Rs458B[4+i*2];			
		}
		memset(RXBuff_Rs458B,'\0',sizeof(RXBuff_Rs458B));//清空RS485B接收缓存
	}
}


