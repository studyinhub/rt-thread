void netdev_callback_4g(struct netdev *netdev, enum netdev_cb_type type)
{
    int ret = RT_EOK;
    int retry = 3;
    switch (type)
    {
    case NETDEV_CB_STATUS_UP:
        LOG_I("4G UP");
        easyblink(led_green, -1, 10, 500);
        break;
    case NETDEV_CB_STATUS_DOWN:
        eb_led_off(led_green);
        LOG_E("4G DOWN");
        break;
    case NETDEV_CB_STATUS_LINK_UP:
        easyblink(led_green, -1, 250, 500);
        LOG_I("4G LINK UP");
        //g_LED_MODE.G4 = 1;
        break;
    case NETDEV_CB_STATUS_LINK_DOWN:
        LOG_E("4G LINK DOWN");
        easyblink_stop(led_green);

        //				extern void rt_hw_cpu_reset(void);
        //				rt_hw_cpu_reset();

        //g_LED_MODE.G4 = 0;
        break;
    case NETDEV_CB_STATUS_INTERNET_UP:
        LOG_I("4G INTERNET UP!!!");
        easyblink(led_green, -1, 500, 1000);

        rt_thread_mdelay(5000);

        do
        {
            ret = getDeviceDetail();
            if (ret == RT_EOK)
            {
                break;
            }
            log_w("get failed,retry:%d", retry);
        } while (--retry > 0);

        break;
    case NETDEV_CB_STATUS_INTERNET_DOWN:
        LOG_W("4G INTERNET DOWN!!!");
        easyblink_stop(led_green);
    default:
        break;
    }
}

