static int init_mqtt()
{

    rt_err_t ret = RT_EOK;

    int res = 0;
    iotx_mqtt_param_t mqtt_params;

    log_i("connect to ali-iot");

    // HAL_GetProductKey(DEMO_PRODUCT_KEY);
    // HAL_GetDeviceName(DEMO_DEVICE_NAME);
    // HAL_GetDeviceSecret(DEMO_DEVICE_SECRET);

    HAL_SetProductKey(DEMO_PRODUCT_KEY);
    HAL_SetDeviceName(DEMO_DEVICE_NAME);
    HAL_SetDeviceSecret(DEMO_DEVICE_SECRET);

    memset(&mqtt_params, 0x0, sizeof(mqtt_params));

    mqtt_params.handle_event.h_fp = example_event_handle;

    char host[128] = {0};
    sprintf(host, "%s.iot-as-mqtt.cn-shanghai.aliyuncs.com", DEMO_PRODUCT_KEY);

    mqtt_params.host = host;
    mqtt_params.request_timeout_ms = 5000;
    mqtt_params.keepalive_interval_ms = 1200000;

    res = example_subscribe(pclient);
    if (res < 0)
    {
        IOT_MQTT_Destroy(&pclient);
        return -1;
    }

    pclient = IOT_MQTT_Construct(&mqtt_params);
    if (NULL == pclient)
    {
        log_i("MQTT construct failed");
        return -1;
    }

    IOT_MQTT_Yield(pclient, 20000);

    /* 创建 serial 线程 */
    rt_thread_t thread = rt_thread_create("mqtt", mqtt_thread_entry, RT_NULL, 4096, 5, 10);
    /* 创建成功则启动线程 */
    if (thread != RT_NULL)
    {
        rt_thread_startup(thread);
    }
    else
    {
        ret = RT_ERROR;
    }
    return ret;
}

