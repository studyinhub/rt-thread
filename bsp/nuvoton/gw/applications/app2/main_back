static int getDeviceDetail()
{
    // 由于之前将 imei 存储在了 ramdisk

    uint32_t length = 0;
    char buffer[81];
    struct dfs_fd fd;

    char filename[10] = {0};

    sprintf(filename, "imei");

    if (dfs_file_open(&fd, filename, O_RDONLY) < 0)
    {
        rt_kprintf("Open %s failed\n", filename);

        return RT_ERROR;
    }

    memset(buffer, 0, sizeof(buffer));

    do
    {
        length = dfs_file_read(&fd, buffer + length, sizeof(buffer) - 1);
        if (length > 0)
        {
            log_d("%s", buffer);
        }

    } while (length > 0);

    dfs_file_close(&fd);

    char uri[256] = {0};
    sprintf(uri, "http://f0a4843a-0c13-4bd8-b784-933245cc8871.bspapp.com/http/admin?action=devices/getDeviceSecret&deviceName=%s", buffer);

    rt_kprintf("uri:%s", uri);

    char *http_resposne = malloc(2048);

    webclient_get_comm(uri, http_resposne);

    rt_kprintf("response:%s", http_resposne);

    rt_kprintf("\r\n");
    rt_kprintf("\r\n");
    rt_kprintf("\r\n");

    cJSON *root = NULL;
    cJSON *item = NULL; //cjson对象
    cJSON *bodyData = NULL;

    root = cJSON_Parse(http_resposne);
    rt_kprintf("%s\n", cJSON_PrintUnformatted(root));

    item = cJSON_GetObjectItem(root, "state");

    if (!rt_strcmp(item->valuestring, "ok"))
    {
        item = cJSON_GetObjectItem(root, "body");

        rt_kprintf("%s\n", cJSON_Print(item));

        bodyData = cJSON_GetObjectItem(item, "data");

        rt_kprintf("%s\n", cJSON_Print(bodyData));

        item = cJSON_GetObjectItem(bodyData, "productKey");
        rt_strncpy(DEMO_PRODUCT_KEY, item->valuestring, rt_strlen(item->valuestring));
        rt_kprintf("DEMO_PRODUCT_KEY:%s\n", DEMO_PRODUCT_KEY);

        item = cJSON_GetObjectItem(bodyData, "deviceName");
        rt_strncpy(DEMO_DEVICE_NAME, item->valuestring, rt_strlen(item->valuestring));
        rt_kprintf("DEMO_DEVICE_NAME:%s\n", DEMO_DEVICE_NAME);

        item = cJSON_GetObjectItem(bodyData, "deviceSecret");
        rt_strncpy(DEMO_DEVICE_SECRET, item->valuestring, rt_strlen(item->valuestring));
        rt_kprintf("DEMO_DEVICE_SECRET:%s\n", DEMO_DEVICE_SECRET);

        init_mqtt();
    }
    else
    {
        log_e("get data error,please retry");
        return RT_ERROR;
    }

    return RT_EOK;
