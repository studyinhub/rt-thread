/* 用于接收消息的信号量 */
static struct rt_semaphore rx_sem;
/* 消息队列控制块 */
static struct rt_messagequeue rx_mq;

#define DATA_CMD_END '\r'    /* 结束位设置为 \r，即回车符 */
#define ONE_DATA_MAXLEN 1024 /* 不定长数据的最大长度 */

/* 串口接收消息结构*/
struct rx_msg
{
    rt_device_t dev;
    rt_size_t size;
};

// http://openedv.com/thread-300874-1-1.html
/* 接收数据回调函数 */
static rt_err_t uart_rx_ind(rt_device_t dev, rt_size_t size)
{
    struct rx_msg msg;
    rt_err_t result = RT_EOK;
    msg.dev = dev;
    msg.size = size;

    // result = rt_mq_send(&rx_mq, &msg, sizeof(msg));
    // if ( result == -RT_EFULL)
    // {
    //     /* 消息队列满 */
    //     rt_kprintf("message queue full！\n");
    // }

    /* 串口接收到数据后产生中断，调用此回调函数，然后发送接收信号量 */
    if (size > 0)
    {
        rt_sem_release(&rx_sem);
    }
    return result;
}

static char uart_sample_get_char(void)
{
    char ch;

    while (rt_device_read(serial, 0, &ch, 1) == 0)
    {
        rt_sem_control(&rx_sem, RT_IPC_CMD_RESET, RT_NULL);
        rt_sem_take(&rx_sem, RT_WAITING_FOREVER);
    }
    return ch;
}
static rt_timer_t oneshort_timer; // on-short
static rt_bool_t oneshort_timer_flag = RT_FALSE;

static void *pclient = NULL;

static int example_publish(void *handle, char *payload);

char serial_recv_buf[ONE_DATA_MAXLEN] = {0};
static char recv_index = 0;

static void oneshort_timer_cb(void *parameter)
{

    LOG_D("one shot timer is timeout");
    example_publish(pclient, "hello");
    recv_index = 0;
    oneshort_timer_flag = RT_TRUE;
}
/* 数据解析线程 */
static void data_parsing(void)
{
    char ch;

    oneshort_timer = rt_timer_create("oneshort_timer", oneshort_timer_cb,
                                     RT_NULL, rt_tick_from_millisecond(1000),
                                     RT_TIMER_FLAG_ONE_SHOT);

    while (1)
    {
        ch = uart_sample_get_char();
        // 收到第一个字符启动定时器，如果在定时器到期之后没有收到第二个字符则发送
        // 或者收到 \r 换行之后也立即发送

        // if (oneshort_timer != RT_NULL) rt_timer_start(oneshort_timer);

        // rt_device_write(serial, 0, &ch, 1);

        if (ch == DATA_CMD_END)
        {
            serial_recv_buf[recv_index++] = '\0';
            rt_kprintf("data=%s\r\n", serial_recv_buf);
            recv_index = 0;
            example_publish(pclient, serial_recv_buf);
            continue;
        }
        // 如果数据达到了最大长度，则将最后收到的字符进行覆盖
        recv_index = (recv_index >= ONE_DATA_MAXLEN - 1) ? ONE_DATA_MAXLEN - 1 : recv_index;
        serial_recv_buf[recv_index++] = ch;
    }
}

// 中断方式
static int init_uart()
{
    rt_err_t ret = RT_EOK;
    char uart_name[RT_NAME_MAX];
    char str[] = "Hello Device\r\n";
    struct serial_configure config = RT_SERIAL_CONFIG_DEFAULT; /* 初始化配置参数 */

    rt_strncpy(uart_name, SAMPLE_UART_NAME, RT_NAME_MAX);

    /* 查找串口设备 */
    serial = rt_device_find(uart_name);
    if (!serial)
    {
        rt_kprintf("find %s failed!\n", uart_name);
        return RT_ERROR;
    }

    config.baud_rate = BAUD_RATE_115200; //修改波特率为 115200
    config.data_bits = DATA_BITS_8;      //数据位 8
    config.stop_bits = STOP_BITS_1;      //停止位 1
    config.bufsz = 128;                  //修改缓冲区 buff size 为 128
    config.parity = PARITY_NONE;         //无奇偶校验位

    rt_device_control(serial, RT_DEVICE_CTRL_CONFIG, &config);

    /* 初始化信号量 */
    rt_sem_init(&rx_sem, "rx_sem", 0, RT_IPC_FLAG_FIFO);
    /* 以中断接收及轮询发送模式打开串口设备 */
    rt_device_open(serial, RT_DEVICE_FLAG_INT_RX);
    /* 设置接收回调函数 */
    rt_device_set_rx_indicate(serial, uart_rx_ind);
    /* 发送字符串 */
    rt_device_write(serial, 0, str, (sizeof(str) - 1));

    /* 创建 serial 线程 */
    rt_thread_t thread = rt_thread_create("serial", (void (*)(void *parameter))data_parsing, RT_NULL, 4096, 25, 10);
    /* 创建成功则启动线程 */
    if (thread != RT_NULL)
    {
        rt_thread_startup(thread);
    }
    else
    {
        ret = RT_ERROR;
    }
    return ret;
}
INIT_APP_EXPORT(init_uart);

